{
    "id": "./",
    "name": "Davao Rent Zone",
    "short_name": "Rent Zone",
    "description": "Manage bookings, rental availability, inquiries, and sales for Davao rentals and services.",
    "lang": "en-PH",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#f6f3ea",
    "theme_color": "#173c34",
    "categories": ["business", "productivity", "travel"],
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "short_name": "Dashboard",
            "description": "Open your rental overview",
            "url": "dashboard",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Booking calendar",
            "short_name": "Calendar",
            "description": "Open booking availability",
            "url": "calendar",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Inquiries",
            "short_name": "Inquiries",
            "description": "Open customer inquiries",
            "url": "inquiries",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ]
}
