APP_NAME="Davao Rent Zone"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://davaorentzone.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Copy the exact database values shown in hPanel -> Databases -> Management.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_crisbooking
DB_USERNAME=u123456789_crisbooking
DB_PASSWORD=replace_with_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# "sync" works without a permanently running queue worker on shared hosting.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Hostinger Email example. Replace these values with the mailbox in hPanel.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=bookings@davaorentzone.com
MAIL_PASSWORD=replace_with_mailbox_password
MAIL_FROM_ADDRESS=bookings@davaorentzone.com
MAIL_FROM_NAME="${APP_NAME}"

# Never commit real OAuth credentials. Register these exact HTTPS callback URLs:
# https://davaorentzone.com/auth/google/callback
# https://davaorentzone.com/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
